# Twice a day, Tbilisi time, as on the laptop. Enabled with `tuz-services start jobs`.
[Unit]
Description=tuz: warehouse catalogue sync twice a day

[Timer]
OnCalendar=*-*-* 09:00:00 Asia/Tbilisi
OnCalendar=*-*-* 21:00:00 Asia/Tbilisi
# A run missed while the server was off happens once it is back.
Persistent=true

[Install]
WantedBy=timers.target
