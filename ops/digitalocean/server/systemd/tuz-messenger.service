# The Garage 1886 Messenger worker on the Droplet (docs/garage-messenger.md). No port. It
# answers the page's chats and comments, sends through Meta's Graph API and runs the
# Facebook syncs. Installed by ops/digitalocean/server/bootstrap; started with
# `tuz-services start bot`.
#
# ONE WORKER ONLY, on one machine: while the laptop's garage-messenger.service runs, this
# unit must stay stopped, or every customer gets two answers.
[Unit]
Description=Garage 1886: Messenger bot worker (replies, comments, page stats, ads)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=exec
User=tuz-messenger
Group=tuz-messenger
SupplementaryGroups=tuz-data
WorkingDirectory=/opt/tuz/current
Environment=PYTHONUNBUFFERED=1
# Written by ops/digitalocean/push-env: the page-token key, the AI keys, the worker's
# database login and the catalogue logins. Never the warehouse writer or migration login.
EnvironmentFile=/etc/tuz/messenger.env
ExecStart=/opt/tuz/current/.venv/bin/python -m automotive.messenger_worker
Restart=always
RestartSec=10
# Exit status 2 means a setting is missing or malformed and the journal names it.
# Restarting cannot fix that: correct it with push-env. Status 1 (database not up) is retried.
RestartPreventExitStatus=2
# On SIGTERM the worker lets running turns finish for up to 70 seconds (DRAIN_SECONDS in
# automotive/messenger_worker.py), then closes the engine.
TimeoutStopSec=90
UMask=0077

# The same sandbox the laptop unit runs under (ops/systemd/garage-messenger.service), where
# every line was checked against the worker. No MemoryDenyWriteExecute: see tuz-site.service.
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
# The engine keeps its source cache, chat log and research cache in data/messenger.
ReadWritePaths=/var/lib/tuz/data/messenger
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
