# The receiver for Meta's webhooks on the Droplet (docs/garage-messenger.md), behind nginx
# on 127.0.0.1:8771. Of everything here it is the process Meta, and so anyone on the
# internet, talks to. Its settings file holds only the app secret, the verify token and an
# append-only database login (role garage_webhook) that cannot read the stored tokens.
# Installed by ops/digitalocean/server/bootstrap; started with `tuz-services start web`.
[Unit]
Description=Garage 1886: Meta webhook receiver (127.0.0.1:8771, behind nginx)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=exec
User=tuz-webhook
Group=tuz-webhook
WorkingDirectory=/opt/tuz/current
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/tuz/receiver.env
ExecStart=/opt/tuz/current/.venv/bin/python -m automotive.meta_receiver
Restart=always
RestartSec=5
# Exit status 2 means a setting is missing or malformed and the journal names it.
RestartPreventExitStatus=2
# uvicorn lets open requests finish for up to 10 seconds (timeout_graceful_shutdown).
TimeoutStopSec=20
UMask=0077

# The same sandbox the laptop unit runs under (ops/systemd/garage-meta-receiver.service).
# The process writes no file; its log goes to the journal.
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
