# The read-only warehouse catalogue sync on the Droplet, run by tuz-warehouse-sync.timer.
# It reads the warehouse over the network and writes only to the database.
#
# It runs in the application's "development" mode, exactly as on the laptop: the warehouse
# is reached over plain HTTP with a browser cookie, which the fail-closed production mode
# (warehouse_sync/config.py) refuses. The owner waived that on 2026-11-22; see
# docs/production-runbook.md. When the cookie expires the run fails with exit status 10.
[Unit]
Description=tuz: read-only warehouse catalogue sync
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=tuz-sync
Group=tuz-sync
WorkingDirectory=/opt/tuz/current
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/tuz/sync.env
ExecStart=/opt/tuz/current/.venv/bin/python -m warehouse_sync
# A full sync reads about 1300 pages and took 30-40 minutes on the laptop.
TimeoutStartSec=2h
Nice=10
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
