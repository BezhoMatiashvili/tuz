#!/usr/bin/env bash
# The first step of the cutover (docs/deploy-digitalocean.md): stops the laptop's services
# that answer customers or write to the database, and makes them impossible to start again
# by accident. A laptop Messenger worker that comes back after the move answers every
# customer a second time and moves Meta's webhook address back to ngrok, so "disable" is not
# enough: each unit file is moved aside and the unit is masked, and the script proves it by
# trying to start one. The nightly laptop backup and the keep-awake unit are left alone.
#
#   ops/digitalocean/retire-laptop-services            # show what would happen
#   ops/digitalocean/retire-laptop-services --yes      # do it
#   ops/digitalocean/retire-laptop-services --undo     # put the units back (does not start them)
set -euo pipefail

units=(
    garage-messenger.service garage-meta-receiver.service garage-ngrok.service
    garage-site-local.service parts-crawler.service
    tuz-warehouse-sync.timer tuz-warehouse-sync.service
    tuz-automotive-index.timer tuz-automotive-index.service
)
home="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
aside="$home/retired-by-cutover"

case "${1:-}" in
    --undo)
        for unit in "${units[@]}"; do
            if [[ -L "$home/$unit" ]]; then systemctl --user unmask "$unit" >/dev/null; fi
            if [[ -f "$aside/$unit" ]]; then mv "$aside/$unit" "$home/$unit"; fi
        done
        rmdir "$aside" 2>/dev/null || true
        systemctl --user daemon-reload
        echo "units are back in $home. Nothing was started or enabled."
        exit 0
        ;;
    --yes) ;;
    "")
        echo "Would stop, disable, move aside and mask these laptop units:"
        for unit in "${units[@]}"; do
            printf '  %-34s %s\n' "$unit" "$(systemctl --user is-active "$unit" 2>/dev/null || true)"
        done
        echo "Customers get no answers from the moment this runs until the server's bot starts."
        echo "Run again with --yes to do it."
        exit 0
        ;;
    *) echo "error: unknown option $1" >&2; exit 2 ;;
esac

mkdir -p "$aside"
for unit in "${units[@]}"; do
    systemctl --user disable --now "$unit" 2>/dev/null || true
    # A unit file in this folder cannot be masked in place: systemd refuses to replace it.
    if [[ -f "$home/$unit" && ! -L "$home/$unit" ]]; then mv "$home/$unit" "$aside/$unit"; fi
done
systemctl --user daemon-reload
for unit in "${units[@]}"; do
    systemctl --user mask "$unit" >/dev/null
done

still="$(for unit in "${units[@]}"; do
    systemctl --user is-active --quiet "$unit" 2>/dev/null && echo "$unit"
done || true)"
[[ -z "$still" ]] || { echo "error: still running: $still" >&2; exit 1; }
if systemctl --user start garage-messenger.service 2>/dev/null; then
    systemctl --user stop garage-messenger.service
    echo "error: garage-messenger could still be started" >&2
    exit 1
fi
echo "retired: ${#units[@]} units stopped and masked; their files are in $aside"
echo "to put them back: ops/digitalocean/retire-laptop-services --undo"
