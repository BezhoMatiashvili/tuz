#!/usr/bin/env bash
set -euo pipefail

revision="${1:?a full approved commit SHA is required}"
[[ "$revision" =~ ^[0-9a-f]{40}$ ]] || exit 2

repository=/opt/warehouse-sync
git -C "$repository" fetch --quiet origin "$revision"
git -C "$repository" cat-file -e "${revision}^{commit}"
git -C "$repository" checkout --detach --force "$revision"
sudo -u warehouse-sync uv sync --locked --no-dev --project "$repository"
systemctl restart warehouse-sync.service
