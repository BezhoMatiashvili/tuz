# Local development only. This file must never describe production.
WAREHOUSE_APP_ENV=development

# Local Docker PostgreSQL. Change the password before anything beyond local development.
POSTGRES_DB=warehouse_sync
POSTGRES_USER=warehouse_sync
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_HOST_PORT=55432
DATABASE_URL=postgresql://warehouse_sync:change-this-local-password@127.0.0.1:55432/warehouse_sync

# Source application. The endpoint is read-only and returns an HTML fragment.
WAREHOUSE_BASE_URL=http://45.9.45.34:6068
WAREHOUSE_PRODUCTS_PATH=/app/Warehouse/app/Ajax/GetProducts.php

# Paste a freshly generated Cookie header here LOCALLY, never into chat or git.
# Example format only: PHPSESSID=...; Authv4=...
WAREHOUSE_COOKIE=

# Be gentle with the legacy PHP source application.
WAREHOUSE_TIMEOUT_SECONDS=30
WAREHOUSE_REQUEST_DELAY_SECONDS=0.30
WAREHOUSE_MAX_RETRIES=3
WAREHOUSE_MAX_RESPONSE_BYTES=4194304

# A base64-encoded, random, 32-byte-or-longer key for local development only.
# Generate locally: python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
WAREHOUSE_HMAC_KEY=

# Separate local automotive application (http://127.0.0.1:8767).
# For an existing migrated local warehouse, initialize these safely with:
# uv run python -m automotive --setup-local
# Use distinct LOGIN users granted automotive_runtime and automotive_enrichment,
# respectively. Never use the sync writer, schema owner or admin here.
AUTOMOTIVE_DATABASE_URL=
AUTOMOTIVE_ENRICHMENT_DATABASE_URL=
# Independent random secrets, at least 32 characters/bytes; keep them server-side.
AUTOMOTIVE_OPERATOR_TOKEN=
AUTOMOTIVE_VIN_HMAC_KEY=
# Official Anthropic API; inference is metered, calls are bounded per turn.
ANTHROPIC_API_KEY=
# Omit for a workspace-scoped key; required for an unscoped key.
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional: let the model reword result replies. A fact checker rejects any number, code,
# brand or claim the backend did not state and keeps the backend sentence. Off by default:
# measured at 1.2-3 s extra per result reply with little gain over the backend sentences.
AUTOMOTIVE_CHAT_REPHRASE=false
AUTOMOTIVE_CHAT_REPHRASE_SECONDS=1.2
# Which engine answers chat: assistant (the model searches the catalogue through read tools
# and judges the rows itself), orchestrated or scripted. Leave it empty to select by
# AUTOMOTIVE_CHAT_ORCHESTRATION below, as before.
AUTOMOTIVE_CHAT_ENGINE=assistant
# The assistant engine. Model: claude-sonnet-5-5 is the one the test conversations chose
# (python -m automotive --evaluate-assistant conversations); empty uses ANTHROPIC_MODEL.
# Effort: low, medium, high, or empty for the API default. One turn is bounded by seconds
# (10-120), model requests (1-8) and tool calls (1-20).
AUTOMOTIVE_ASSISTANT_MODEL=claude-sonnet-5-5
AUTOMOTIVE_ASSISTANT_EFFORT=low
# Thinking: empty keeps the model's own default (recommended: the test conversations lose
# answers without it); off asks for no thinking before an answer.
AUTOMOTIVE_ASSISTANT_THINKING=
AUTOMOTIVE_ASSISTANT_TURN_SECONDS=30
AUTOMOTIVE_ASSISTANT_MAX_REQUESTS=4
AUTOMOTIVE_ASSISTANT_MAX_TOOL_CALLS=10
# How long the provider keeps the fixed part of the prompt ready: 1h or 5m. With an hour the
# first message after a quiet spell does not wait for the prompt to be read again; writing
# it costs twice the input price instead of 1.25 times.
AUTOMOTIVE_ASSISTANT_CACHE_TTL=1h
# What the catalogue's part names mean, in plain English, printed beside the names in the
# guide the assistant reads. A model reads them from the rows that carry each name:
# python -m automotive --read-part-names (again after the catalogue gains new part names;
# --all reads every name anew). Empty, or a file that does not exist: names without readings.
AUTOMOTIVE_ASSISTANT_NAMES_PATH=data/assistant/part_names.json
# The older engines only: AI-led conversations; set false to restore legacy routing.
AUTOMOTIVE_CHAT_ORCHESTRATION=true
# One chat turn's limit. Web research for part numbers alone takes 20-40 seconds.
AUTOMOTIVE_CHAT_TURN_SECONDS=75
# Private catalog/chooser/research cache. Warehouse stock is always refreshed separately.
AUTOMOTIVE_CACHE_PATH=data/automotive-cache.sqlite3

# Learned knowledge base (migration 0008). Enable only after source reuse policies are set.
# The validator is a separate LOGIN granted automotive_validator; --setup-local adds one.
AUTOMOTIVE_KNOWLEDGE_ENABLED=false
AUTOMOTIVE_VALIDATOR_DATABASE_URL=
AUTOMOTIVE_JUDGE_MODEL=claude-sonnet-5-5
AUTOMOTIVE_KNOWLEDGE_DAILY_ATTEMPTS=25
AUTOMOTIVE_KNOWLEDGE_CONCURRENCY=1
AUTOMOTIVE_KNOWLEDGE_MAX_SEARCHES=5
AUTOMOTIVE_KNOWLEDGE_MAX_FETCHES=5
AUTOMOTIVE_KNOWLEDGE_DEADLINE_SECONDS=120
AUTOMOTIVE_KNOWLEDGE_FRESHNESS_DAYS=180

# Local chat log (private SQLite file of redacted chat turns, for improving answers).
# Defaults to data/chat_logs/chat_log.sqlite3; set it empty to turn logging off.
# Retention is in days, 0 keeps everything. Export: uv run python -m automotive.chat_log --export out.jsonl
AUTOMOTIVE_CHAT_LOG_PATH=data/chat_logs/chat_log.sqlite3
AUTOMOTIVE_CHAT_LOG_RETENTION_DAYS=0

# Garage 1886 site: public landing page, staff login and dashboard (docs/garage-site.md).
# `uv run python -m automotive.site_setup --setup-site` writes AUTOMOTIVE_SITE_DATABASE_URL.
AUTOMOTIVE_SITE_DATABASE_URL=
# Staff login for /staff and /api/v1. `false` is accepted only while every host is loopback.
AUTOMOTIVE_STAFF_AUTH=true
# Comma-separated https origins the site is served on, and the reverse proxy's address.
# Leave both empty for local use. A public origin without the proxy's address is refused
# at start-up: every visitor would share one rate limit.
AUTOMOTIVE_PUBLIC_ORIGINS=
AUTOMOTIVE_TRUSTED_PROXIES=
# Whole-site daily allowances for visitors, and the visitors' own chat log.
AUTOMOTIVE_SITE_CHAT_DAILY_TURNS=300
AUTOMOTIVE_SITE_VIN_DAILY_DECODES=200
AUTOMOTIVE_SITE_CHAT_LOG_PATH=data/chat_logs/site_chat_log.sqlite3
AUTOMOTIVE_SITE_CHAT_LOG_RETENTION_DAYS=30

# Optional paid VIN -> OE/part-number catalog (TecDoc-style, e.g. RapidAPI "Auto Parts Catalog").
# Leave the key empty to keep it off. After adding it run once:
#   uv run python -m automotive --check-catalog-api
CATALOG_API_KEY=
CATALOG_API_BASE_URL=https://auto-parts-catalog.p.rapidapi.com
CATALOG_API_HOST=auto-parts-catalog.p.rapidapi.com
CATALOG_API_KEY_HEADER=x-rapidapi-key

# Public Motorium VIN/part-code lookup (no local Anthropic key required).
MOTORIUM_ENABLED=false
# Public oil and filter choosers. Set any value to false to skip that source.
FUCHS_ENABLED=true
SHELL_ENABLED=true
PAKELO_ENABLED=true
JSFILTER_ENABLED=true

# Parts catalog crawler (docs/parts-crawler.md). `python -m parts_crawler setup-local`
# writes PARTS_CRAWLER_DATABASE_URL; the rest are optional and have safe minimums.
PARTS_CRAWLER_DATABASE_URL=
PARTS_CRAWLER_CONTACT=
PARTS_CRAWLER_MIN_DELAY_SECONDS=5
PARTS_CRAWLER_JITTER_SECONDS=1.5
PARTS_CRAWLER_MAX_ATTEMPTS=6
PARTS_CRAWLER_DATA_DIR=
# Sources allowed to request a path their site's robots.txt disallows (comma-separated).
# Empty by default. Only mann_api uses it, for /api/graphql/ on www.mann-filter.com;
# without the entry that source does not start. See docs/parts-crawler.md.
PARTS_CRAWLER_ROBOTS_EXEMPT=
