# Local development only. This file must never describe production.
WAREHOUSE_APP_ENV=development

# Local Docker PostgreSQL. Change the password before anything beyond local development.
POSTGRES_DB=warehouse_sync
POSTGRES_USER=warehouse_sync
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_HOST_PORT=55432
DATABASE_URL=postgresql://warehouse_sync:change-this-local-password@127.0.0.1:55432/warehouse_sync

# Source application. The endpoint is read-only and returns an HTML fragment.
WAREHOUSE_BASE_URL=http://45.9.45.34:6068
WAREHOUSE_PRODUCTS_PATH=/app/Warehouse/app/Ajax/GetProducts.php

# Paste a freshly generated Cookie header here LOCALLY, never into chat or git.
# Example format only: PHPSESSID=...; Authv4=...
WAREHOUSE_COOKIE=

# Be gentle with the legacy PHP source application.
WAREHOUSE_TIMEOUT_SECONDS=30
WAREHOUSE_REQUEST_DELAY_SECONDS=0.30
WAREHOUSE_MAX_RETRIES=3
WAREHOUSE_MAX_RESPONSE_BYTES=4194304

# A base64-encoded, random, 32-byte-or-longer key for local development only.
# Generate locally: python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
WAREHOUSE_HMAC_KEY=

# Separate local automotive application (http://127.0.0.1:8767).
# For an existing migrated local warehouse, initialize these safely with:
# uv run python -m automotive --setup-local
# Use distinct LOGIN users granted automotive_runtime and automotive_enrichment,
# respectively. Never use the sync writer, schema owner or admin here.
AUTOMOTIVE_DATABASE_URL=
AUTOMOTIVE_ENRICHMENT_DATABASE_URL=
# Independent random secrets, at least 32 characters/bytes; keep them server-side.
AUTOMOTIVE_OPERATOR_TOKEN=
AUTOMOTIVE_VIN_HMAC_KEY=
# Official Anthropic API; inference is metered, calls are bounded per turn.
ANTHROPIC_API_KEY=
# Omit for a workspace-scoped key; required for an unscoped key.
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-haiku-5-5

# Public Motorium VIN/part-code lookup (no local Anthropic key required).
MOTORIUM_ENABLED=true
